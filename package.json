{
  "name": "feeldown-backend",
  "version": "0.0.1",
  "description": "backend after drinking",
  "author": {
    "name": "FOCKUSTY",
    "email": "viserd.yt@gmail.com",
    "url": "https://fockusty.netlify.app"
  },
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "build": "nest build",
    "generate": "pnpx prisma generate",
    "swagger": "set PROGRAM_MODE=swagger&& nest start",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "set PROGRAM_MODE=production&& nest start",
    "start:watch": "set PROGRAM_MODE=production&& nest start --watch",
    "start:dev": "set PROGRAM_MODE=development&& nest start",
    "dev": "set PROGRAM_MODE=development&& nest start --watch",
    "debug": "nest start --debug --watch",
    "docker:build": "docker build -f dockerfile -t feeldown-backend .",
    "docker:dev": "docker run -e PROGRAM_MODE=development -p 8080:8080 feeldown-backend",
    "docker:prod": "docker run -e PROGRAM_MODE=production -p 8080:8080 feeldown-backend",
    "prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest --config ./test/jest.config.js",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.config.js"
  },
  "dependencies": {
    "@nestjs/cache-manager": "^3.1.3",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/platform-socket.io": "^11.2.1",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.2.1",
    "bad-fockarch": "^3.1.2",
    "bcrypt": "^6.0.0",
    "cache-manager": "^7.2.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "fenviee": "^0.1.2",
    "fockeror": "^0.4.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "passport": "^0.7.0",
    "passport-github": "^1.1.0",
